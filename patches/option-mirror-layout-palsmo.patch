 	int m = focused ? focused->mon : 0;
 	float *mw = &user_config.master_width[m];
 
-	if (*mw > MF_MIN + 0.001f)
-		*mw -= ((float)user_config.resize_master_amt / 100);
+	if (user_config.mirror_layout) {
+		if (*mw > MF_MIN - 0.001f)
+			*mw += ((float)user_config.resize_master_amt / 100);
+	}
+	else {
+		if (*mw > MF_MIN + 0.001f)
+			*mw -= ((float)user_config.resize_master_amt / 100);
