Author: palsmo
Date: 2026-10-13
Description: add mirror layout option
Commit Version: 695e7a5 (Merge pull request #265 from elbachir-one/README)

Add 'mirror_layout' configuration option to flip master-stack layout.
When enabled, master window stays on the right side instead of the default left,
and resize controls are reversed to maintain intuitive behavior.

---
 common.h |  2 +-
 parser.c |  1 +
 sxwm.c   | 19 +++++++++++++++----
 3 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/common.h b/common.h
index 33e042d..e2885d9 100644
--- a/common.h
+++ b/common.h
@@ -95,7 +95,7 @@ struct Config {
 	long border_foc_col, border_ufoc_col, border_pin_col;
 	float master_width[MAX_MONITORS];
 	char* should_float[MAX_ITEMS], *start_fullscreen[MAX_ITEMS], *to_run[MAX_ITEMS];
-	Bool new_win_focus ,warp_cursor ,floating_on_top ,new_win_master;
+	Bool new_win_focus ,warp_cursor ,floating_on_top ,new_win_master ,mirror_layout;
 	WorkspaceRule open_in_workspace[MAX_ITEMS];
 	Binding binds[MAX_ITEMS];
 };
diff --git a/parser.c b/parser.c
index 77bbd56..b2936e0 100644
--- a/parser.c
+++ b/parser.c
@@ -80,6 +80,7 @@ static const Option options[] = {
 	{ "snap_distance",            offsetof(Config, snap_distance), OPT_INT },
 	{ "unfocused_border_colour",  offsetof(Config, border_ufoc_col), OPT_COLOR },
 	{ "warp_cursor",              offsetof(Config, warp_cursor), OPT_BOOL },
+    { "mirror_layout",            offsetof(Config, mirror_layout), OPT_BOOL },
 };
 
 static Binding* alloc_bind(Config* cfg, Binding bind)
diff --git a/sxwm.c b/sxwm.c
index e9516a0..d6e7180 100644
--- a/sxwm.c
+++ b/sxwm.c
@@ -800,6 +800,7 @@ static void init_defaults(void)
 	cfg.warp_cursor = True;
 	cfg.new_win_master = False;
 	cfg.floating_on_top = True;
+    cfg.mirror_layout = False;
 }
 
 static Bool is_floating(Client* c)
@@ -1589,7 +1590,10 @@ static void resize_master(int amount)
 	int m = focused ? focused->mon : 0;
 	float* mw = &cfg.master_width[m];
 
-	*mw = CLAMP(*mw + (float)amount / 100.0f, MF_MIN, MF_MAX);
+	if (cfg.mirror_layout)
+        *mw = CLAMP(*mw - (float)amount / 100.0f, MF_MIN, MF_MAX);
+	else
+        *mw = CLAMP(*mw + (float)amount / 100.0f, MF_MIN, MF_MAX);
 
 	tile();
 }
@@ -1977,17 +1981,24 @@ static void tile(void)
 		}
 
 		int master_w = n > 1 ? (int)(w * CLAMP(cfg.master_width[m], MF_MIN, MF_MAX)) : w;
+		int stack_w = w - master_w - gaps;
+
+		/* mirror_layout puts the master on the right and the stack on the left */
+		int master_x = x;
+		int stack_x = x + master_w + gaps;
+		if (cfg.mirror_layout && n > 1) {
+			stack_x = x;
+			master_x = x + stack_w + gaps;
+		}
 
 		/* master */
-		configure_tile(master, x, y, master_w, h);
+		configure_tile(master, master_x, y, master_w, h);
 
 		if (n == 1)
 			continue;
 
 		/* stack */
 		int n_stack = n - 1;
-		int stack_x = x + master_w + gaps;
-		int stack_w = w - master_w - gaps;
 		int available = h - (n_stack - 1) * gaps;
 		int stack_h = MAX(2 * cfg.border_width + 1, available / n_stack);
 		int extra = MAX(0, available - n_stack * stack_h);
-- 
