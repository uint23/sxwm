+/* returns the next '&' separated action, ignoring '&' inside quotes. NULL when done */
+static char* next_action(char** pos)
+{
+	char* s = *pos;
+	if (!s)
+		return NULL;
+
+	char quote = '\0';
+	char* p;
+	for (p = s; *p; p++) {
+		if (quote) {
+			if (*p == quote)
+				quote = '\0';
+		}
+		else if (*p == '"' || *p == '\'') {
+			quote = *p;
+		}
+		else if (*p == '&') {
+			break;
+		}
+	}
+
+	if (*p) {
+		*p = '\0';
+		*pos = p + 1;
+	}
+	else {
+		*pos = NULL;
+	}
+
+	return strip(s);
+}
